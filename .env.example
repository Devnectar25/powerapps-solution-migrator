# Copy to .env and fill in.

# Entra ID app registration (multi-tenant for cross-tenant migrations). Required unless MOCK_MODE=true.
CLIENT_ID=
# Only if the app is registered with a "Web" platform (confidential client). Leave empty for public client.
CLIENT_SECRET=

PORT=3000
# Must match a redirect URI on the app registration.
# REDIRECT_URI=http://localhost:3000/auth/callback

# Run with simulated tenants/environments/solutions (no Microsoft sign-in needed).
MOCK_MODE=false

# Corporate network: proxy address if your company requires one (ask IT), e.g. http://proxy.company.com:8080
# PROXY_URL=
# Trust the Windows/macOS certificate store (needed when the company inspects HTTPS traffic). Default true.
# USE_SYSTEM_CA=true

# Saved profiles, migration history and packages
# DATA_DIR=./data
# KEEP_PACKAGES=10

# Sovereign clouds (defaults are the public cloud):
# AUTHORITY_HOST=https://login.microsoftonline.com
# ARM_URL=https://management.azure.com
# DISCOVERY_URL=https://globaldisco.crm.dynamics.com
# DATAVERSE_HOST_SUFFIXES=.dynamics.com

# Max minutes one request may wait for Dataverse (large imports can take a long time to be accepted)
# REQUEST_TIMEOUT_MINUTES=60

# Polling of async export/import operations
# POLL_INTERVAL_MS=3000
# ASYNC_TIMEOUT_MINUTES=120

# --- User registration & organization profiles (Supabase) ---------------------------------------
# When set, people must register their organization, verify their work email and be approved
# before they can use the migrator. See SUPABASE_SETUP.md. Use the anon / publishable key only,
# never the service_role (secret) key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# auto (default: on when Supabase is configured) | on | off
# REGISTRATION=auto
# Address used in verification and password-reset email links (default: the address in the browser)
# APP_URL=http://localhost:3000
# Demo mode includes a built-in demo registration backend; MOCK_REGISTRATION=off switches it off
# MOCK_REGISTRATION=off

# --- Hosting for many users (see DEPLOYMENT.md) ----------------------------------------------------
# HOSTED=true makes registration mandatory, gives each user their own workspace, makes Settings
# read-only and listens on 0.0.0.0. Run exactly one instance on a continuously running Node.js host
# (Azure App Service, a container) - not on serverless functions such as Vercel.
# HOSTED=true
# APP_URL=https://your-app.azurewebsites.net   (also sets the redirect URI to APP_URL/auth/callback)
# DATA_DIR=/home/data
